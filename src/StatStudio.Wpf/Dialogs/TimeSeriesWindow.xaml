<Window x:Class="StatStudio.Wpf.Dialogs.TimeSeriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Series" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Series:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="SeriesCombo"/>
        </DockPanel>
        <DockPanel x:Name="TrendRow" Margin="0,0,0,8">
            <TextBlock Text="Trend type:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="TrendCombo"/>
        </DockPanel>
        <DockPanel x:Name="LengthRow" Margin="0,0,0,8">
            <TextBlock Text="MA length:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="LengthBox" Text="3"/>
        </DockPanel>
        <DockPanel x:Name="PeriodRow" Margin="0,0,0,8">
            <TextBlock Text="Seasonal period:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="PeriodBox" Text="12"/>
        </DockPanel>
        <DockPanel x:Name="AlphaRow" Margin="0,0,0,8">
            <TextBlock Text="Alpha (level):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="AlphaBox" Text="0.2"/>
        </DockPanel>
        <DockPanel x:Name="BetaRow" Margin="0,0,0,8">
            <TextBlock Text="Beta (trend):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="BetaBox" Text="0.1"/>
        </DockPanel>
        <DockPanel x:Name="GammaRow" Margin="0,0,0,8">
            <TextBlock Text="Gamma (seasonal):" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="GammaBox" Text="0.1"/>
        </DockPanel>
        <DockPanel x:Name="MaxLagRow" Margin="0,0,0,8">
            <TextBlock Text="Max lag:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxLagBox" Text="12"/>
        </DockPanel>
        <DockPanel x:Name="ForecastRow" Margin="0,0,0,8">
            <TextBlock Text="Forecasts:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="ForecastBox" Text="4"/>
        </DockPanel>
        <CheckBox x:Name="MultBox" Content="Multiplicative model" Margin="0,2,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
