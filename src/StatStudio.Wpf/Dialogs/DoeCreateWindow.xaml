<Window x:Class="StatStudio.Wpf.Dialogs.DoeCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Create Factorial Design" Height="Auto" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock Foreground="#9CDCFE" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Full 2^k factorial in coded units (±1). The design is written to a new worksheet."/>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Number of factors (k):" Width="160" VerticalAlignment="Center"/>
            <TextBox x:Name="FactorsBox" Text="3"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Replicates:" Width="160" VerticalAlignment="Center"/>
            <TextBox x:Name="RepBox" Text="1"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Center points / replicate:" Width="160" VerticalAlignment="Center"/>
            <TextBox x:Name="CenterBox" Text="0"/>
        </DockPanel>
        <CheckBox x:Name="RandomizeBox" Content="Randomize run order" IsChecked="True" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
