<Window x:Class="StatStudio.Wpf.Dialogs.BayesNormalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Bayesian Normal Mean" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Data column:" Width="160" VerticalAlignment="Center"/><ComboBox x:Name="DataCombo"/></DockPanel>
        <CheckBox x:Name="KnownBox" Content="Known variance (Normal prior)" Margin="0,2,0,8" Checked="OnKnownChanged" Unchecked="OnKnownChanged"/>
        <DockPanel x:Name="PriorMeanRow" Margin="0,0,0,8"><TextBlock Text="Prior mean (μ0):" Width="160" VerticalAlignment="Center"/><TextBox x:Name="PriorMeanBox" Text="0"/></DockPanel>
        <DockPanel x:Name="PriorSdRow" Margin="0,0,0,8"><TextBlock Text="Prior SD (τ0):" Width="160" VerticalAlignment="Center"/><TextBox x:Name="PriorSdBox" Text="10"/></DockPanel>
        <DockPanel x:Name="SigmaRow" Margin="0,0,0,8"><TextBlock Text="Known σ:" Width="160" VerticalAlignment="Center"/><TextBox x:Name="SigmaBox" Text="1"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Threshold (P(μ&gt;·)):" Width="160" VerticalAlignment="Center"/><TextBox x:Name="ThreshBox" Text="0"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Credible level (%):" Width="160" VerticalAlignment="Center"/><TextBox x:Name="ConfBox" Text="95"/></DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
