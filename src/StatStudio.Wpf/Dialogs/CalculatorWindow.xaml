<Window x:Class="StatStudio.Wpf.Dialogs.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Calculator" Height="320" Width="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Store result in column:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="TargetBox" Text="C1"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Expression:" Foreground="#9CDCFE" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Foreground="#808080" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Columns: C1, C2, … or names ('My Col' in quotes). Operators: + - * / ^.  Functions: SQRT, LOG (ln), LOG10, EXP, ABS, SIN/COS/TAN, ROUND, FLOOR, CEILING.  Aggregates: MEAN, SUM, STDEV, MIN, MAX, MEDIAN, N."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="ExprBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14"/>
    </DockPanel>
</Window>
