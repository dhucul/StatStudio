<Window x:Class="StatStudio.Wpf.Dialogs.RsmCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        Title="Create Response Surface Design" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Design type:" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeCombo" SelectionChanged="OnTypeChanged"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Number of factors:" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="FactorsCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Center points:" Width="160" VerticalAlignment="Center"/>
            <TextBox x:Name="CenterBox" Text="4"/>
        </DockPanel>
        <CheckBox x:Name="FaceBox" Content="Face-centered (α = 1)" Margin="0,2,0,8"/>
        <CheckBox x:Name="RandomizeBox" Content="Randomize run order" IsChecked="True" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
