<Window x:Class="StatStudio.Wpf.Dialogs.ColumnPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select columns" Height="440" Width="380"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock x:Name="Prompt" DockPanel.Dock="Top" Foreground="#9CDCFE"
                   Margin="0,0,0,8" TextWrapping="Wrap" Text="Select variables:"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Border BorderBrush="#3C3C3C" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="4"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
