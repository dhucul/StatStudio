<Window x:Class="StatStudio.Wpf.Dialogs.PowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Power and Sample Size" Height="Auto" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Test:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="TestCombo" SelectionChanged="OnTestChanged"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Solve for:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="SolveCombo" SelectionChanged="OnSolveChanged"/>
        </DockPanel>
        <DockPanel x:Name="EffectRow" Margin="0,0,0,8">
            <TextBlock Text="Effect size (d):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="EffectBox" Text="0.5"/>
        </DockPanel>
        <DockPanel x:Name="P0Row" Margin="0,0,0,8">
            <TextBlock Text="Baseline p0:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="P0Box" Text="0.5"/>
        </DockPanel>
        <DockPanel x:Name="P1Row" Margin="0,0,0,8">
            <TextBlock Text="Comparison p1:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="P1Box" Text="0.6"/>
        </DockPanel>
        <DockPanel x:Name="NRow" Margin="0,0,0,8">
            <TextBlock Text="Sample size (n):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="NBox" Text="30"/>
        </DockPanel>
        <DockPanel x:Name="PowerRow" Margin="0,0,0,8">
            <TextBlock Text="Target power:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="PowerBox" Text="0.8"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Alpha:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="AlphaBox" Text="0.05"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Alternative:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="AltCombo"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
