<Window x:Class="StatStudio.Wpf.Dialogs.BayesProportionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bayesian Proportion" Height="Auto" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock Foreground="#9CDCFE" Margin="0,0,0,10" Text="Beta(a,b) prior + x successes in n trials."/>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Events (x):" Width="150" VerticalAlignment="Center"/><TextBox x:Name="XBox" Text="8"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Trials (n):" Width="150" VerticalAlignment="Center"/><TextBox x:Name="NBox" Text="10"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Prior a:" Width="150" VerticalAlignment="Center"/><TextBox x:Name="ABox" Text="1"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Prior b:" Width="150" VerticalAlignment="Center"/><TextBox x:Name="BBox" Text="1"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Threshold (P(p&gt;·)):" Width="150" VerticalAlignment="Center"/><TextBox x:Name="ThreshBox" Text="0.5"/></DockPanel>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Credible level (%):" Width="150" VerticalAlignment="Center"/><TextBox x:Name="ConfBox" Text="95"/></DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
