<Window x:Class="StatStudio.Wpf.Dialogs.KaplanMeierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaplan-Meier" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Time column:" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="TimesCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Censor column:" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="CensorCombo"/>
        </DockPanel>
        <TextBlock Foreground="#808080" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Censor column: 1 = right-censored, 0 = failure (event). Choose (none) to treat all as failures."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
