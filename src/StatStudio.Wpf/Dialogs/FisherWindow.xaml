<Window x:Class="StatStudio.Wpf.Dialogs.FisherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Fisher's Exact Test (2×2)" Height="220" Width="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#9CDCFE" Text="Enter the 2×2 counts:" Grid.ColumnSpan="3" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Row 1" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="A" Text="3" Margin="0,0,6,8"/>
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="B" Text="1" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Row 2" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="C" Text="1" Margin="0,0,6,8"/>
        <TextBox Grid.Row="2" Grid.Column="2" x:Name="D" Text="3" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
