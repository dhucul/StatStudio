<Window x:Class="StatStudio.Wpf.Dialogs.OneSampleTWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1-Sample t" Height="480" Width="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="#9CDCFE" Margin="0,0,0,8"
                   Text="Variables (a test is run for each):"/>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="4"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hypothesized mean:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MeanBox" Text="0" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Alternative:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AltCombo" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Confidence (%):" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ConfBox" Text="95" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
