<Window x:Class="StatStudio.Wpf.Dialogs.DistFitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        Title="Distribution Analysis" Height="Auto" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Failure times:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="TimesCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Distribution:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="DistCombo"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
