<Window x:Class="StatStudio.Wpf.Dialogs.ArimaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIMA" Height="Auto" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Series:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="SeriesCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="AR order (p):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="PBox" Text="1"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Differencing (d):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="DBox" Text="0"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="MA order (q):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="QBox" Text="0"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Forecasts:" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="ForecastBox" Text="6"/>
        </DockPanel>
        <CheckBox x:Name="ConstBox" Content="Include constant term" IsChecked="True" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
