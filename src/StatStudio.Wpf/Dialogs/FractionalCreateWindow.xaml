<Window x:Class="StatStudio.Wpf.Dialogs.FractionalCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Create Fractional Factorial" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock Foreground="#9CDCFE" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="2^(k-p) fractional design using standard minimum-aberration generators."/>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Number of factors (k):" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="FactorsCombo" SelectionChanged="OnFactorsChanged"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Runs (fraction):" Width="160" VerticalAlignment="Center"/>
            <ComboBox x:Name="RunsCombo"/>
        </DockPanel>
        <CheckBox x:Name="RandomizeBox" Content="Randomize run order" IsChecked="True" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
