<Window x:Class="StatStudio.Wpf.Dialogs.MixtureCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="#D4D4D4"
        Title="Create Mixture Design" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Design type:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeCombo" SelectionChanged="OnTypeChanged"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Components:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComponentsCombo"/>
        </DockPanel>
        <DockPanel x:Name="DegreeRow" Margin="0,0,0,8">
            <TextBlock Text="Lattice degree (m):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="DegreeBox" Text="2"/>
        </DockPanel>
        <CheckBox x:Name="RandomizeBox" Content="Randomize run order" IsChecked="True" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
