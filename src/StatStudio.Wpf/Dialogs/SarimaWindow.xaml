<Window x:Class="StatStudio.Wpf.Dialogs.SarimaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        Title="Seasonal ARIMA (SARIMA)" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Series:" Width="170" VerticalAlignment="Center"/>
            <ComboBox x:Name="SeriesCombo"/>
        </DockPanel>
        <TextBlock Text="Non-seasonal (p, d, q):" Foreground="{DynamicResource AccentLight}" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,8">
            <TextBox x:Name="PBox" Text="1" Width="60" Margin="0,0,8,0"/>
            <TextBox x:Name="DBox" Text="0" Width="60" Margin="0,0,8,0"/>
            <TextBox x:Name="QBox" Text="0" Width="60"/>
        </DockPanel>
        <TextBlock Text="Seasonal (P, D, Q):" Foreground="{DynamicResource AccentLight}" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,8">
            <TextBox x:Name="SPBox" Text="0" Width="60" Margin="0,0,8,0"/>
            <TextBox x:Name="SDBox" Text="1" Width="60" Margin="0,0,8,0"/>
            <TextBox x:Name="SQBox" Text="1" Width="60"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Seasonal period (s):" Width="170" VerticalAlignment="Center"/>
            <TextBox x:Name="SBox" Text="12"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Forecasts:" Width="170" VerticalAlignment="Center"/>
            <TextBox x:Name="ForecastBox" Text="12"/>
        </DockPanel>
        <CheckBox x:Name="ConstBox" Content="Include constant term" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="80" Click="OnOk" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
