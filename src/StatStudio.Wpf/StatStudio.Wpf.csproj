<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StatStudio.Core\StatStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.58" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StatStudio</AssemblyName>
    <Version>2.2.2</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- ScottPlot.WPF pulls SkiaSharp.Views.WPF which only ships net4x TFMs; it runs
         fine on modern .NET via the compat shim, so silence the cosmetic NU1701. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
