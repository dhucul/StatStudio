<Window x:Class="StatStudio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StatStudio" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Worksheet" Click="OnNewWorksheet"/>
                <MenuItem Header="_Open Data (CSV / Excel)…" Click="OnOpenCsv"/>
                <MenuItem Header="_Save Worksheet As…" Click="OnSaveCsv"/>
                <Separator/>
                <MenuItem Header="Open _Project (.ssproj)…" Click="OnOpenProject"/>
                <MenuItem Header="Save Pro_ject As…" Click="OnSaveProject"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Stat" x:Name="StatMenu">
                <MenuItem Header="_Basic Statistics">
                    <MenuItem Header="_Display Descriptive Statistics…" Click="OnDescriptives"/>
                    <Separator/>
                    <MenuItem Header="_1-Sample t…" Click="OnOneSampleT"/>
                    <MenuItem Header="_2-Sample t…" Click="OnTwoSampleT"/>
                    <MenuItem Header="_Paired t…" Click="OnPairedT"/>
                    <Separator/>
                    <MenuItem Header="1 _Proportion…" Click="OnOneProportion"/>
                    <MenuItem Header="2 P_roportions…" Click="OnTwoProportions"/>
                    <Separator/>
                    <MenuItem Header="Chi-Square _Goodness-of-Fit…" Click="OnChiSquareGof"/>
                    <MenuItem Header="_Cross Tabulation &amp; Chi-Square…" Click="OnChiSquareAssoc"/>
                    <Separator/>
                    <MenuItem Header="Co_rrelation (Pearson)…" Click="OnCorrelationPearson"/>
                    <MenuItem Header="Correlation (_Spearman)…" Click="OnCorrelationSpearman"/>
                    <MenuItem Header="_Normality Test (Anderson-Darling)…" Click="OnNormalityTest"/>
                    <MenuItem Header="_2 Variances (F-Test)…" Click="OnTwoVariances"/>
                    <MenuItem Header="_Fisher's Exact Test (2×2)…" Click="OnFishersExact"/>
                </MenuItem>
                <MenuItem Header="_ANOVA">
                    <MenuItem Header="_One-Way (with Tukey)…" Click="OnOneWayAnova"/>
                    <MenuItem Header="_Two-Way…" Click="OnTwoWayAnova"/>
                    <Separator/>
                    <MenuItem Header="Test for _Equal Variances…" Click="OnEqualVariances"/>
                </MenuItem>
                <MenuItem Header="_Nonparametrics">
                    <MenuItem Header="_Mann-Whitney…" Click="OnMannWhitney"/>
                    <MenuItem Header="_Wilcoxon Signed-Rank (1-Sample)…" Click="OnWilcoxon"/>
                    <MenuItem Header="_Kruskal-Wallis…" Click="OnKruskalWallis"/>
                    <MenuItem Header="_Sign Test (1-Sample)…" Click="OnSignTest"/>
                    <MenuItem Header="_Runs Test…" Click="OnRunsTest"/>
                </MenuItem>
                <MenuItem Header="_Regression">
                    <MenuItem Header="_Simple Regression…" Click="OnSimpleRegression"/>
                    <MenuItem Header="_Multiple Regression…" Click="OnMultipleRegression"/>
                    <MenuItem Header="_Polynomial Regression…" Click="OnPolynomialRegression"/>
                    <Separator/>
                    <MenuItem Header="_Best Subsets…" Click="OnBestSubsets"/>
                    <MenuItem Header="Step_wise…" Click="OnStepwise"/>
                    <Separator/>
                    <MenuItem Header="Binary _Logistic Regression…" Click="OnLogistic"/>
                </MenuItem>
                <MenuItem Header="_Time Series">
                    <MenuItem Header="_Trend Analysis…" Click="OnTrendAnalysis"/>
                    <MenuItem Header="_Moving Average…" Click="OnMovingAverage"/>
                    <Separator/>
                    <MenuItem Header="_Single Exp Smoothing…" Click="OnSingleExp"/>
                    <MenuItem Header="_Double Exp Smoothing…" Click="OnDoubleExp"/>
                    <MenuItem Header="_Winters' Method…" Click="OnWinters"/>
                    <Separator/>
                    <MenuItem Header="_Decomposition…" Click="OnDecomposition"/>
                    <MenuItem Header="_Autocorrelation (ACF)…" Click="OnAcf"/>
                    <MenuItem Header="_Partial Autocorrelation (PACF)…" Click="OnPacf"/>
                    <Separator/>
                    <MenuItem Header="A_RIMA…" Click="OnArima"/>
                    <MenuItem Header="_SARIMA (Seasonal)…" Click="OnSarima"/>
                </MenuItem>
                <MenuItem Header="_Multivariate">
                    <MenuItem Header="_Principal Components…" Click="OnPca"/>
                    <MenuItem Header="_Factor Analysis…" Click="OnFactorAnalysis"/>
                    <MenuItem Header="Cluster _K-Means…" Click="OnKMeans"/>
                </MenuItem>
                <MenuItem Header="_Reliability / Survival">
                    <MenuItem Header="_Distribution Analysis…" Click="OnDistFit"/>
                    <MenuItem Header="_Kaplan-Meier…" Click="OnKaplanMeier"/>
                </MenuItem>
                <MenuItem Header="_DOE">
                    <MenuItem Header="_Create Factorial Design…" Click="OnCreateFactorial"/>
                    <MenuItem Header="Create _Fractional Factorial…" Click="OnCreateFractional"/>
                    <MenuItem Header="_Analyze Factorial Design…" Click="OnAnalyzeFactorial"/>
                    <Separator/>
                    <MenuItem Header="Create _Response Surface…" Click="OnCreateRsm"/>
                    <MenuItem Header="Analy_ze Response Surface…" Click="OnAnalyzeRsm"/>
                </MenuItem>
                <MenuItem Header="Po_wer and Sample Size…" Click="OnPowerSampleSize"/>
                <MenuItem Header="_Control Charts">
                    <MenuItem Header="Xbar-_R…" Click="OnXbarR"/>
                    <MenuItem Header="Xbar-_S…" Click="OnXbarS"/>
                    <MenuItem Header="_I-MR…" Click="OnImr"/>
                    <Separator/>
                    <MenuItem Header="_P…" Click="OnPChart"/>
                    <MenuItem Header="_NP…" Click="OnNpChart"/>
                    <MenuItem Header="_C…" Click="OnCChart"/>
                    <MenuItem Header="_U…" Click="OnUChart"/>
                </MenuItem>
                <MenuItem Header="_Quality Tools">
                    <MenuItem Header="_Capability Analysis (Normal)…" Click="OnCapability"/>
                    <MenuItem Header="_Gage R&amp;R (Crossed)…" Click="OnGageRR"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Graph">
                <MenuItem Header="_Histogram…" Click="OnHistogram"/>
                <MenuItem Header="_Boxplot…" Click="OnBoxplot"/>
                <MenuItem Header="_Scatterplot…" Click="OnScatterplot"/>
                <MenuItem Header="_Time Series Plot…" Click="OnTimeSeries"/>
                <MenuItem Header="_Probability Plot…" Click="OnProbabilityPlot"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About StatStudio" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DimsText" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigator -->
            <DockPanel Grid.Column="0" Background="#252526">
                <TextBlock DockPanel.Dock="Top" Text="Navigator" Margin="8,6"
                           Foreground="#9CDCFE" FontWeight="SemiBold"/>
                <ListBox x:Name="NavList" BorderThickness="0" Background="#252526"
                         MouseDoubleClick="OnNavDoubleClick"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#3C3C3C"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="1.7*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Session output -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="Session" Margin="8,6"
                               Foreground="#9CDCFE" FontWeight="SemiBold"/>
                    <TextBox x:Name="Session" IsReadOnly="True" BorderThickness="0"
                             Background="#1E1E1E" FontFamily="Consolas" FontSize="13"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="#3C3C3C"/>

                <!-- Worksheet -->
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="WorksheetHeader" DockPanel.Dock="Top" Text="Worksheet"
                               Margin="8,6" Foreground="#9CDCFE" FontWeight="SemiBold"/>
                    <DataGrid x:Name="Sheet" AutoGenerateColumns="True" CanUserAddRows="True"
                              CanUserDeleteRows="True" HeadersVisibility="All"
                              SelectionUnit="CellOrRowHeader" BorderThickness="0"
                              AutoGeneratingColumn="OnGridAutoGeneratingColumn"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
